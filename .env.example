# MyMedigapRate.com — optional configuration
#
# The site builds and deploys with NO environment variables set.
# Everything below is optional. Never commit real values: copy this file to
# .env.local (git-ignored) for local work, and set production values in the
# Vercel dashboard.

# Public site origin, used for canonical URLs, sitemap.xml and robots.txt.
# Defaults to https://www.mymedigaprate.com when unset.
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key, from https://web3forms.com — the UUID shown when you
# create a form. It is PUBLIC BY DESIGN: it is submitted from the browser and is
# visible in the page source of every form that uses it. It is not a secret and
# is not a private API key.
#
# LEAVE THIS BLANK unless you are rotating the key. The working key is committed
# as the default in lib/site.ts, so both forms work with no variable set. This
# variable exists only to override that default — set it in Vercel and it wins,
# so a rotation still needs no commit. A blank or whitespace-only value falls
# back to the default rather than switching the forms off.
#
# Web3Forms redirects to https://www.mymedigaprate.com/thank-you on success;
# that URL is derived from NEXT_PUBLIC_SITE_URL, so set that too if you are
# running on a preview domain and want the redirect to stay on it.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When unset, no analytics script is injected.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional override used by `npm run data:status` only, when the reconciliation
# kit lives outside the repo. The site itself always reads the kit from
# data/csg/ecos-csg/recon/ (git-ignored) and builds fine when it is absent —
# every figure then renders as unverified.
CSG_DATA_DIR=
