# MyMedigapRate.com — optional configuration
#
# The site builds and deploys with NO environment variables set.
# Everything below is optional. Never commit real values: copy this file to
# .env.local (git-ignored) for local work, and set production values in the
# Vercel dashboard.

# Public site origin, used for canonical URLs, sitemap.xml and robots.txt.
# Defaults to https://www.mymedigaprate.com when unset.
NEXT_PUBLIC_SITE_URL=

# Optional contact-form POST endpoint (e.g. a form-relay service).
# When unset, the contact page renders phone/email only and no form.
# This is a public, client-visible value — do not put a private API key here.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When unset, no analytics script is injected.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional override used by `npm run data:status` only, when the reconciliation
# kit lives outside the repo. The site itself always reads the kit from
# data/csg/ecos-csg/recon/ (git-ignored) and builds fine when it is absent —
# every figure then renders as unverified.
CSG_DATA_DIR=
